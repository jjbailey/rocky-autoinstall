# Makefile: Rocky Linux Autoinstall ISO Builder & OEMDRV Kickstart Seed Image

MAJOR   := 10
VERSION := $(MAJOR).2
ARCH    := x86_64
ISO     := Rocky-$(VERSION)-$(ARCH)-dvd1.iso
ISO_URL := https://download.rockylinux.org/pub/rocky/$(MAJOR)/isos/$(ARCH)/$(ISO)
ISODIR  := rocky-$(VERSION)-autoinstall
NEWISO  := $(ISODIR).iso
SRC     := $(ISODIR)/source-files
PROJECT_HOME := $(CURDIR)

PATCHSTAMP := $(ISODIR)/.patched

MARK_BEGIN := ROCKY-AUTOINSTALL-MENU-BEGIN
MARK_END   := ROCKY-AUTOINSTALL-MENU-END

VOLID := Rocky-$(subst .,-,$(VERSION))-$(ARCH)-dvd

KS := ks.cfg

OEMDRV    := oemdrv.img
OEMDRV_MB := 8

ISO_DEPS  := curl xorriso
SEED_DEPS := mkfs.vfat mount umount dd fsck.fat

.PHONY: all check-deps check-files validate clean distclean download extract \
        addfiles patch oemdrv

.NOTPARALLEL:

all: check-deps check-files validate $(NEWISO)

validate:
	@if command -v ksvalidator >/dev/null 2>&1; then \
		ksvalidator -v RHEL$(MAJOR) "$(KS)" || exit 1; \
	else \
		echo "ksvalidator not found (dnf install pykickstart) -- skipping $(KS) syntax check"; \
	fi

check-deps:
	@for dep in $(ISO_DEPS); do \
		command -v $$dep >/dev/null 2>&1 || { echo "'$$dep' is not installed"; exit 1; }; \
	done

check-files:
	@test -f "$(KS)" || { echo "Missing $(KS) -- try: cp ks-bios+efi.ks $(KS)"; exit 1; }
	@test -f grub-autoinstall.menu || { echo "Missing grub-autoinstall.menu"; exit 1; }

download: $(ISO)
$(ISO):
	curl -C - --remote-time -o "$@" "$(ISO_URL)"

extract: $(SRC)/boot/grub2/grub.cfg

$(SRC)/boot/grub2/grub.cfg: $(ISO)
	rm -rf $(ISODIR)
	mkdir -p $(SRC)
	xorriso -osirrox on -indev "$(ISO)" -extract / $(SRC)
	chmod -R u+w $(SRC)
	@# Fail loudly here rather than producing an ISO that will not boot.
	test -f $(SRC)/boot/grub2/grub.cfg
	test -f $(SRC)/EFI/BOOT/grub.cfg
	test -f $(SRC)/boot/grub2/i386-pc/boot_hybrid.img
	test -f $(SRC)/images/pxeboot/vmlinuz
	test -f $(SRC)/images/pxeboot/initrd.img
	test -f $(SRC)/images/eltorito.img
	test -f $(SRC)/images/efiboot.img
	test -f $(SRC)/images/install.img

addfiles: $(SRC)/ks.cfg

$(SRC)/ks.cfg: $(KS) | $(SRC)/boot/grub2/grub.cfg
	cp -p "$(KS)" $(SRC)/ks.cfg

patch: $(PATCHSTAMP)

$(PATCHSTAMP): grub-autoinstall.menu $(SRC)/boot/grub2/grub.cfg
	@for GRUB_CFG in "$(SRC)/boot/grub2/grub.cfg" "$(SRC)/EFI/BOOT/grub.cfg"; do \
		sed -i "s|inst.stage2=hd:LABEL=[^ ]*|inst.stage2=hd:LABEL=$(VOLID)|g" "$$GRUB_CFG"; \
		sed -i "/$(MARK_BEGIN)/,/$(MARK_END)/d" "$$GRUB_CFG"; \
		MENU=$$(mktemp); \
		sed -e "s|@VOLID@|$(VOLID)|g" "$(PROJECT_HOME)/grub-autoinstall.menu" > $$MENU; \
		if grep -q '^[[:space:]]*linuxefi' "$$GRUB_CFG"; then \
			sed -i -e 's|^\([[:space:]]*\)linux[[:space:]]|\1linuxefi |' \
			       -e 's|^\([[:space:]]*\)initrd[[:space:]]|\1initrdefi |' $$MENU; \
		fi; \
		FIRST_ENTRY=$$(grep -n -m1 '^[[:space:]]*menuentry' "$$GRUB_CFG" | cut -d: -f1); \
		test -n "$$FIRST_ENTRY" || { echo "No menuentry found in $$GRUB_CFG"; rm -f $$MENU; exit 1; }; \
		head -n $$((FIRST_ENTRY - 1)) "$$GRUB_CFG" > "$$GRUB_CFG.new"; \
		echo "# $(MARK_BEGIN) -- generated by 'make patch'; edits are overwritten" >> "$$GRUB_CFG.new"; \
		cat $$MENU >> "$$GRUB_CFG.new"; \
		echo "# $(MARK_END)" >> "$$GRUB_CFG.new"; \
		tail -n +$$FIRST_ENTRY "$$GRUB_CFG" >> "$$GRUB_CFG.new"; \
		mv "$$GRUB_CFG.new" "$$GRUB_CFG"; \
		rm -f $$MENU; \
		sed -i 's|^set default=.*|set default="0"|' "$$GRUB_CFG"; \
		echo "Patched GRUB menu: $$GRUB_CFG"; \
	done
	@touch $@

grub-autoinstall.menu:
	@echo "Please create a grub-autoinstall.menu file with your custom GRUB menu entries." ; exit 1

$(NEWISO): $(PATCHSTAMP) $(SRC)/ks.cfg
	rm -f "$(PROJECT_HOME)/$(NEWISO)"
	cd $(SRC) && xorriso -as mkisofs \
		-r -J -joliet-long \
		-V "$(VOLID)" \
		-o "$(PROJECT_HOME)/$(NEWISO)" \
		--grub2-mbr boot/grub2/i386-pc/boot_hybrid.img \
		-c boot.catalog \
		-b images/eltorito.img \
		-no-emul-boot \
		-boot-info-table \
		--grub2-boot-info \
		-eltorito-alt-boot \
		-e images/efiboot.img \
		-no-emul-boot \
		-isohybrid-gpt-basdat \
		.


oemdrv: $(OEMDRV)

$(OEMDRV): $(KS)
	@for dep in $(SEED_DEPS); do \
		command -v $$dep >/dev/null 2>&1 || { echo "'$$dep' is not installed"; exit 1; }; \
	done
	@if [ "$$(id -u)" -ne 0 ]; then \
		echo "This rule must be run as root (sudo make oemdrv)"; exit 1; \
	fi
	rm -f $(OEMDRV)
	dd if=/dev/zero of=$(OEMDRV) bs=1M count=$(OEMDRV_MB) status=none
	mkfs.vfat -n OEMDRV $(OEMDRV)
	MNTDIR=$$(mktemp -d /tmp/oemdrv.XXXXXX) || exit 1; \
	if mount -o loop $(OEMDRV) $$MNTDIR; then \
		cp "$(KS)" $$MNTDIR/ks.cfg && test -s $$MNTDIR/ks.cfg && sync; \
		rc=$$?; \
		umount $$MNTDIR || rc=1; \
	else \
		echo "Failed to mount $(OEMDRV) on $$MNTDIR"; \
		rc=1; \
	fi; \
	rmdir $$MNTDIR 2>/dev/null; \
	[ $$rc -eq 0 ] || { echo "Failed to write $(KS) into $(OEMDRV)"; rm -f $(OEMDRV); exit 1; }
	@fsck.fat -nv $(OEMDRV) >/dev/null || { echo "Image integrity check FAILED!"; exit 1; }
	@echo "OEMDRV kickstart seed image created: $(OEMDRV)"

clean:
	rm -rf $(ISODIR) $(NEWISO) $(OEMDRV)

distclean: clean
	rm -f $(ISO)
